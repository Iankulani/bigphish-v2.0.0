# Scorpion-Effect Environment Configuration

# Application Settings
SCORPION_ENV=production
DEBUG=false
SECRET_KEY=change_this_to_random_string

# Web Interface
WEB_PORT=5000
WEB_HOST=0.0.0.0
PHISHING_PORT=8080

# Database
DATABASE_PATH=.scorpion-effect/scorpion.db
USE_POSTGRES=false
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=scorpion
POSTGRES_USER=scorpion
POSTGRES_PASSWORD=secure_password_here

# Redis (for caching)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# Discord Bot
DISCORD_TOKEN=
DISCORD_ENABLED=false

# Telegram Bot
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_BOT_TOKEN=
TELEGRAM_ENABLED=false

# Slack Bot
SLACK_TOKEN=
SLACK_CHANNEL=general
SLACK_ENABLED=false

# Google Chat
GOOGLE_CHAT_ENABLED=false

# Security
ENABLE_SSL=false
SSL_CERT_PATH=
SSL_KEY_PATH=

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/scorpion.log
MAX_LOG_SIZE=10485760
BACKUP_COUNT=5

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT=100
RATE_LIMIT_PERIOD=60

# Phishing Settings
CAPTURE_IP=true
CAPTURE_USER_AGENT=true
REDIRECT_URL=https://www.google.com