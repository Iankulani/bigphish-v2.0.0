# Dockerfile.slim - Minimal Alpine image for Scorpion-Effect
FROM alpine:3.19

# Install minimal dependencies
RUN apk add --no-cache \
    python3 \
    py3-pip \
    nmap \
    curl \
    && rm -rf /var/cache/apk/*

WORKDIR /app

COPY requirements-minimal.txt .
RUN pip3 install --no-cache-dir -r requirements-minimal.txt

COPY scorpion_effect.py .
COPY entrypoint.sh .

RUN chmod +x entrypoint.sh

EXPOSE 5000 8080

CMD ["./entrypoint.sh"]